# WAF eSign production environment.
#
# Copy to `.env` alongside compose.yml on the VM and fill in. Never commit the
# filled-in copy — it holds the database password, the SMTP password and the
# signing certificate passphrase.
#
#   cp .env.example .env && chmod 600 .env

# ── Image ────────────────────────────────────────────────────────────────────
# Immutable tag published by .github/workflows/waf-publish.yml. Pin a specific
# build; `latest` would make rollback guesswork. Roll back by putting the
# previous tag here and running `docker compose up -d`.
IMAGE_TAG=sha-0000000

# ── Host paths ───────────────────────────────────────────────────────────────
# Directory holding esign.waf.com.fj.crt and esign.waf.com.fj.key. Mounted
# read-only into Traefik. Filenames must match traefik/dynamic.yml.
WAF_TLS_DIR=/opt/waf-esign/tls

# The signing certificate. Not in the repository and not in the image — copy it
# to the VM yourself. Must be readable by uid 1001:
#   chown 1001:1001 /opt/waf-esign/cert.p12 && chmod 400 /opt/waf-esign/cert.p12
WAF_SIGNING_CERT_PATH=/opt/waf-esign/cert.p12

# ── Application ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEBAPP_URL=https://esign.waf.com.fj

# Generate each of these separately with: openssl rand -hex 32
# Changing the encryption keys after go-live makes existing encrypted data
# unreadable. Back them up somewhere that is not this VM.
NEXTAUTH_SECRET=
NEXT_PRIVATE_ENCRYPTION_KEY=
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=waf_esign
POSTGRES_PASSWORD=
POSTGRES_DB=waf_esign

# Host is the compose service name. Must agree with the three values above.
NEXT_PRIVATE_DATABASE_URL=postgres://waf_esign:CHANGEME@database:5432/waf_esign

# ── Mail ─────────────────────────────────────────────────────────────────────
# Every signing request and completion notice goes through this. If it is wrong
# the app still starts and recipients simply never hear from it, so send a real
# test document before go-live.
NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
NEXT_PRIVATE_SMTP_HOST=
NEXT_PRIVATE_SMTP_PORT=587
NEXT_PRIVATE_SMTP_USERNAME=
NEXT_PRIVATE_SMTP_PASSWORD=
NEXT_PRIVATE_SMTP_SECURE=false
NEXT_PRIVATE_SMTP_FROM_NAME=WAF eSign
NEXT_PRIVATE_SMTP_FROM_ADDRESS=noreply@waf.com.fj

# ── Signing ──────────────────────────────────────────────────────────────────
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_PASSPHRASE=

# Free, and worth more to an audit trail than the name on the certificate:
# without it, signature times come from this server's clock and nothing else.
# Setting it also switches on long-term validation and archival timestamps.
NEXT_PRIVATE_SIGNING_TIMESTAMP_AUTHORITY=http://timestamp.digicert.com

# Embedded in the PDF signature and shown in Acrobat's signature panel.
NEXT_PUBLIC_SIGNING_CONTACT_INFO=

# ── Access ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DISABLE_SIGNUP=true
# Comma-separated. Only relevant if signup is re-enabled.
NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=waf.com.fj

# ── Optional ─────────────────────────────────────────────────────────────────
# Bytes. Leave unset for the application default.
NEXT_PUBLIC_DOCUMENT_SIZE_UPLOAD_LIMIT=
